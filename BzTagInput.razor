<div class="absolute left-0 top-1 right-0 bottom-1 rounded-l-md bg-gradient-to-r from-white to-transparent whitespace-nowrap overflow-hidden w-full"
     @onclick=FocusHandler
>
    <ul class="inline-block">
        @for (var i = 0; i < Tags.Count; i++)
        {
            int j = i;

            <li class="inline-block">
                <input type="text"
                       class="mx-1 w-px outline-0 bg-transparent"
                       @ref=SpacerInputElements[j]
                       @onkeydown:preventDefault
                       @onkeydown="eventargs => SpacerKeyHandler(eventargs, j)" />
            </li>

            <li class="inline-block outline-0 bg-transparent @(Tags[j].StartsWith('-') ? "negative" : "")">@Tags[j]</li>
        }
    </ul>
    <input
        disabled
        type="text"
        class="inline-block h-full bg-transparent"
        placeholder="Search coming soon.."
        @ref=TagInputElement
        @bind=TagInputValue
        @bind:event="oninput"
        @onkeydown=BeforeInputHandler
        @onkeyup=AfterInputHandler />
</div>